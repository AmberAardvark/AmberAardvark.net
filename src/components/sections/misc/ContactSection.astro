---
// Import the necessary dependencies.
import ContactIconBlock from "@components/ui/blocks/ContactIconBlock.astro";
import Icon from "@components/ui/icons/Icon.astro";
import { getRelativeUrl } from "@utils/utils";

const { locale = "en" } = Astro.props;
interface Props {
  locale?: "en" | "es";
}

const copy =
  locale === "es"
    ? {
        title: "Contáctanos",
        subTitle:
          "Cuéntanos sobre el proceso manual, los datos desconectados o la necesidad especializada que quieres resolver.",
        faq: "Preguntas frecuentes",
        faqContent: "Encuentra respuestas breves a las consultas más comunes.",
        faqLink: "Ver preguntas frecuentes",
        email: "Contáctanos por correo",
        emailContent: "¿Prefieres escribirnos? Envíanos un correo a",
      }
    : {
        title: "Contact us",
        subTitle:
          "Tell us about the manual process, disconnected data, or specialized need you want to solve.",
        faq: "FAQ",
        faqContent:
          "Explore our FAQ for quick, clear answers to common queries.",
        faqLink: "Visit FAQ",
        email: "Contact us by email",
        emailContent: "Prefer the written word? Drop us an email at",
      };
---

<!-- Contact Us -->
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-2xl">
      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.faq}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL={getRelativeUrl(locale === "es" ? "es/#faq" : "#faq")}
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.email}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle="support@amberaardvark.net"
          linkURL="#"
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
