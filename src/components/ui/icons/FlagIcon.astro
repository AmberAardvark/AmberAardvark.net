---
const { country } = Astro.props;

interface Props {
  country: "US" | "MX";
}
---

{
  country === "US" ? (
    <svg
      class="size-5 shrink-0 rounded-[2px]"
      viewBox="0 0 28 20"
      role="img"
      aria-label="United States flag - EN"
    >
      <rect width="28" height="20" fill="#fff" />
      <g fill="#b22234">
        <rect width="28" height="2.86" />
        <rect y="5.72" width="28" height="2.86" />
        <rect y="11.44" width="28" height="2.86" />
        <rect y="17.16" width="28" height="2.84" />
      </g>
      <rect width="12" height="11.44" fill="#3c3b6e" />
      <g fill="#fff">
        <circle cx="2.2" cy="2.1" r=".7" />
        <circle cx="6" cy="2.1" r=".7" />
        <circle cx="9.8" cy="2.1" r=".7" />
        <circle cx="4.1" cy="4.7" r=".7" />
        <circle cx="7.9" cy="4.7" r=".7" />
        <circle cx="2.2" cy="7.3" r=".7" />
        <circle cx="6" cy="7.3" r=".7" />
        <circle cx="9.8" cy="7.3" r=".7" />
        <circle cx="4.1" cy="9.7" r=".7" />
        <circle cx="7.9" cy="9.7" r=".7" />
      </g>
    </svg>
  ) : (
    <svg
      class="size-5 shrink-0 rounded-[2px]"
      viewBox="0 0 28 20"
      role="img"
      aria-label="Mexico flag - ES"
    >
      <rect width="9.34" height="20" fill="#006847" />
      <rect x="9.34" width="9.32" height="20" fill="#fff" />
      <rect x="18.66" width="9.34" height="20" fill="#ce1126" />
      <path
        d="M14 6.5c1.8.6 2.8 2 2.5 4-.3 2-1.1 3.1-2.5 3.6-1.4-.5-2.2-1.6-2.5-3.6-.3-2 .7-3.4 2.5-4Z"
        fill="#a66c29"
      />
      <path
        d="M12 12.5c1.3-1.3 2.7-1.3 4 0M14 8.5v4"
        fill="none"
        stroke="#3a7d44"
        stroke-width=".8"
        stroke-linecap="round"
      />
    </svg>
  )
}
