---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";

// Import necessary images
import blueprints from "@images/dashboard-image.avif";
import personWorking from "@images/amber-aardvark-features.png";
import beforeAfter from "@images/amber-aardvark-map.png";
import aerialView from "@images/dashboard-image.avif";
import { SITE } from "@data/constants";
import { getRelativeUrl } from "@utils/utils";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
  id?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Data Analytics",
    subTitle:
      "Make your operational data useful without building an oversized platform. We assess what you already have, connect and clean the sources that matter, and create focused reporting for the decisions your team makes every day. From recurring reports to a streamlined data foundation, each solution is sized to the value it needs to deliver.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Business data analytics dashboard",
    imgTwo: personWorking,
    imgTwoAlt: "Data analyst preparing connected reporting",
    id: "data-analytics",
  },
  {
    isRightSection: false,
    title: "Process Automation",
    subTitle:
      "Remove the repetitive steps that slow work down. We map the process, connect the tools involved, and automate handoffs, approvals, notifications, and routine data movement. Human review stays where judgment matters, while dependable automation handles the predictable work.",
    img: beforeAfter,
    imgAlt: "Connected business process automation map",
    id: "process-automation",
  },
  {
    isRightSection: true,
    title: "Agentic Workflows",
    subTitle:
      "Use AI agents where they can safely advance a multi-step business process. We design bounded tasks, connect the right systems, add evaluation and human checkpoints, and make the workflow observable. The result is useful automation with clear controls, not an opaque experiment.",
    single: false,
    imgOne: personWorking,
    imgOneAlt: "Team planning an agentic business workflow",
    imgTwo: aerialView,
    imgTwoAlt: "Orchestrated AI agent workflow",
    id: "agentic-workflows",
  },
  {
    isRightSection: false,
    title: "Custom App Development",
    subTitle:
      "Build the focused application your process actually needs. We turn niche workflows, spreadsheets, and workarounds into secure, maintainable web tools with only the features that create value. Modular delivery keeps scope, cost, and future improvements under control.",
    img: aerialView,
    imgAlt: "Custom business application interface",
    id: "custom-app-development",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Affordable data analytics, process automation, agentic workflows, and custom application development from Amber Aardvark.";
const ogTitle = "Automation, Data & Custom App Services | Amber Aardvark";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: "Automation, Data & Custom App Services | Amber Aardvark",
    description:
      "Affordable data analytics, process automation, agentic workflows, and custom application development from Amber Aardvark.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: "Amber Aardvark",
      description:
        "Amber Aardvark builds affordable business solutions for specialized workflows and niche use cases.",
    },
    inLanguage: "en-US",
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <MainSection
    title="Four Services. One Practical Goal."
    subTitle="Reduce operational friction with the right combination of data analytics, process automation, agentic workflows, and custom applications. Every engagement starts with your specific challenge and ends with a maintainable solution sized to its value."
    btnExists={true}
    btnTitle="Schedule a Consultation"
    btnURL={getRelativeUrl("contact")}
  />
  {
    /* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */
  }
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
          id={article.id}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
          id={article.id}
        />
      );
    })
  }
</MainLayout>
