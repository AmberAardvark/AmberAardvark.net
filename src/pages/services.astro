---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/dashboard-image.avif";
import personWorking from "@images/amber-aardvark-features.png";
import beforeAfter from "@images/amber-aardvark-map.png";
import constructionWorkers from "@images/amber-aardvark-features.png";
import aerialView from "@images/dashboard-image.avif";
import usingTools from "@images/amber-aardvark-map.png";
import progressBuilding from "@images/amber-aardvark-features.png";
import underConstruction from "@images/dashboard-image.avif";
import { SITE } from "@data/constants";
import { getRelativeUrl } from "@utils/utils";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
  id?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "Data Strategy & Advisory",
    subTitle:
      "Navigating the complex landscape of modern data analytics requires a clear roadmap. We help you define your data strategy, assess your current maturity, and identify high-impact use cases. Our advisory services ensure your data initiatives align with your business goals and deliver measurable ROI.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Strategic planning session",
    imgTwo: personWorking,
    imgTwoAlt: "Data architect designing solution",
    id: "analytics-consulting",
  },
  {
    isRightSection: false,
    title: "Data Engineering & Architecture",
    subTitle:
      "Build a solid foundation for your analytics. We design and implement scalable, secure, and efficient data platforms on Azure. From data lakes to data warehouses, we engineer robust pipelines using Azure Data Factory, Synapse Analytics, and Databricks to ensure your data is accurate, timely, and accessible.",
    img: beforeAfter,
    imgAlt: "Data architecture diagram",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
    id: "data-engineering",
  },
  {
    isRightSection: true,
    title: "Power BI & Visualization",
    subTitle:
      "Turn data into insights with stunning, interactive dashboards. Our Power BI experts create intuitive visualizations that tell a compelling story. We follow best practices for data modeling (Star Schema) and DAX optimization to ensure your reports are fast, reliable, and easy to use.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Team reviewing Power BI dashboard",
    imgTwo: aerialView,
    imgTwoAlt: "Data visualization on screen",
    id: "power-bi",
  },
  {
    isRightSection: false,
    title: "Process Automation",
    subTitle:
      "Eliminate tedious manual tasks and streamline your operations. We examine your bottlenecks and deploy custom automated workflows that save your team hundreds of hours. Affordable and efficient, our solutions reduce operational costs without the exorbitant price tag of enterprise software.",
    img: usingTools,
    imgAlt: "Planning automation workflows",
    id: "process-automation",
  },
  {
    isRightSection: true,
    title: "Custom App Development",
    subTitle:
      "Off-the-shelf software rarely fits specialized business needs perfectly. We develop tailored, budget-friendly web applications designed exactly for your niche use cases. Enjoy tools that look and work exactly how your team needs them.",
    single: true,
    imgOne: aerialView,
    imgOneAlt: "Web application interface",
    btnExists: true,
    btnTitle: "Learn More",
    btnURL: "#",
    id: "custom-app-development",
  },
  {
    isRightSection: false,
    title: "Agentic Workflows",
    subTitle:
      "When basic automation isn't enough, we build intelligent AI agent systems. These advanced setups work autonomously, collaborating on multi-step tasks specific to your niche. Our custom agentic frameworks handle complexity so you don't have to.",
    img: blueprints,
    imgAlt: "AI agent workflow orchestration diagram",
    id: "agentic-workflows",
  },
  {
    isRightSection: true,
    title: "Managed Support & Improvements",
    subTitle:
      "Focus on running your business while we monitor and maintain your automated workflows, data platforms, and custom apps. Our flexible retainer-based managed services provide continuous iterations, ensuring your digital tools scale seamlessly alongside your company's growth.",
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: "Monitoring dashboard",
    imgTwo: underConstruction,
    imgTwoAlt: "Team collaborating on enhancements",
    btnExists: true,
    btnTitle: "Read more",
    btnURL: "#",
    id: "managed-services",
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  "Expert data analytics, data engineering, process automation, and custom application development services from Amber Aardvark.";
const ogTitle = "Data Analytics & Automation Services | Amber Aardvark";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: "Data Analytics & Automation Services | Amber Aardvark",
    description:
      "Expert data analytics, data engineering, process automation, and custom application development services from Amber Aardvark.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: "Amber Aardvark",
      description:
        "Amber Aardvark offers expert data analytics, process automation, agentic workflows, and custom app development services to fit niche use cases.",
    },
    inLanguage: "en-US",
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <MainSection
    title="Transforming Your Data into True Performance"
    subTitle="As data analytics experts first, we take a comprehensive, big-picture approach to your business. By looking at your data ecosystems and internal bottlenecks as an interconnected whole, we ensure that modern data engineering, combined with new AI workflows and bespoke apps, cascades into massive operational efficiencies across your entire organization."
    btnExists={true}
    btnTitle="Schedule a Consultation"
    btnURL={getRelativeUrl("contact")}
  />
  {
    /* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */
  }
  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
          id={article.id}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
          id={article.id}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="By the Numbers"
    subTitle="Our commitment to efficiency and affordability is evident in every project we undertake. At Amber Aardvark, we are dedicated to delivering high-quality automation and custom applications that help your business scale effortlessly."
    mainStatTitle="96%"
    mainStatSubTitle="of our clients rate their custom solutions and workflows as exceptional"
    stats={[
      {
        stat: "10k+",
        description: "hours saved for our clients annually",
      },
      {
        stat: "50+",
        description: "custom applications deployed",
      },
      {
        stat: "100%",
        description: "focus on affordability and niche requirements",
      },
    ]}
  />
</MainLayout>
