---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import FeaturesNavs from "@components/sections/features/FeaturesNavs.astro";
import PricingSection from "@components/sections/pricing/PricingSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import heroImage from "@images/amber-aardvark-features.png";
import faqs from "@data/faqs.json";
import features from "@data/features.json";
import pricing from "@data/pricing.json";
import featureImage from "@images/amber-aardvark-map.png";
import construction from "@images/dashboard-image.avif";
import tools from "@images/amber-aardvark-features.png";
import dashboard from "@images/dashboard-image.avif";
import { getRelativeUrl } from "@utils/utils";
---

<MainLayout>
  <HeroSection
    title=`Solve the Problems Generic Software Overlooks with <span
        class="text-yellow-500 dark:text-yellow-400 text-outline">Amber Aardvark</span>`
    subTitle="Affordable data analytics, process automation, agentic workflows, and custom business applications - built around the way your team actually works."
    primaryBtn="Our Services"
    primaryBtnURL={getRelativeUrl("services")}
    secondaryBtn="Contact Us"
    secondaryBtnURL={getRelativeUrl("contact")}
    src={heroImage}
    alt="Amber Aardvark business solutions overview"
  />

  <FeaturesGeneral
    title="Business Solutions Built Around Your Reality"
    subTitle="Start with the bottleneck, not a predetermined platform. We combine data, automation, AI-assisted workflows, and custom software into focused solutions that are useful, maintainable, and affordable."
    src={featureImage}
    alt="Connected view of Amber Aardvark services"
    features={features}
  />

  <FeaturesNavs
    title=`Four Ways to Make Your Business Work <span class="text-yellow-500 dark:text-yellow-400 text-outline">Better</span>`
    tabs={[
      {
        heading: "Data Analytics",
        content:
          "Bring scattered information into focus with practical data preparation, clear reporting, and insights tied to decisions your team needs to make.",
        svg: "dashboard",
        src: tools,
        alt: "Business analytics and reporting workspace",
        first: true,
      },
      {
        heading: "Process Automation",
        content:
          "Connect systems, route work, and remove repetitive steps so routine operations move faster with fewer errors and less manual effort.",
        svg: "tools",
        src: dashboard,
        alt: "Connected process automation workflow",
        second: true,
      },
      {
        heading: "Agentic Workflows",
        content:
          "Give AI a defined job within a multi-step process, with the integrations, boundaries, and human checkpoints required for dependable use.",
        svg: "tools",
        src: dashboard,
        alt: "Coordinated agentic business workflow",
      },
      {
        heading: "Custom App Development",
        content:
          "Create focused applications for niche operational needs, replacing awkward workarounds without paying for an oversized enterprise platform.",
        svg: "house",
        src: construction,
        alt: "Interface of a custom business application",
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

  <HeroSectionAlt
    title="Have a Problem That Standard Software Cannot Solve?"
    subTitle="Tell us about the manual process, disconnected data, or specialized workflow holding your team back."
    url={getRelativeUrl("contact")}
  />
</MainLayout>
