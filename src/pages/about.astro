---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";

// Import necessary images
import blueprints from "@images/dashboard-image.avif";
import personWorking from "@images/amber-aardvark-features.png";
import beforeAfter from "@images/amber-aardvark-map.png";
import constructionWorkers from "@images/amber-aardvark-features.png";
import aerialView from "@images/dashboard-image.avif";
import { SITE } from "@data/constants";
import { getRelativeUrl } from "@utils/utils";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "The Legend of the Amber Aardvark",
    subTitle:
      "Why an Aardvark? And why Amber? The Aardvark is nature's expert excavator, famous for its tenacity and ability to sniff out and dig deep to find exactly what it's looking for. Amber, on the other hand, is fossilized tree sap that captures and preserves a perfect snapshot of the world as it was at a specific moment in time. Archaeologists prize amber for the insights it reveals about ancient ecosystems.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Data excavation concept",
    imgTwo: personWorking,
    imgTwoAlt: "Preserved insights",
  },
  {
    isRightSection: false,
    title: "Curiosity & Tenacity",
    subTitle:
      "The Amber Aardvark reflects how we solve problems. We dig beneath the first symptom, follow the unusual detail, and keep going until the real bottleneck is visible. Like amber, a useful solution preserves the important context: the people, constraints, handoffs, and exceptions that make your operation unique.",
    img: beforeAfter,
    imgAlt: "Unlocking business workflows",
    btnExists: false,
  },
  {
    isRightSection: true,
    title: "Practical Solutions, Accessible to More Businesses",
    subTitle:
      "Useful technology should not be reserved for enterprises with the largest budgets. Our services are designed for growing teams and specialized businesses that have outgrown spreadsheets, disconnected tools, or software that almost fits. Whether the answer is analytics, automation, an agentic workflow, or a custom application, we start with a focused outcome and plan the work in maintainable steps.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Team collaboration",
    imgTwo: aerialView,
    imgTwoAlt: "Strategic overview",
  },
];

const pageTitle: string = `About Us | ${SITE.title}`;
const metaDescription =
  "Learn how Amber Aardvark delivers affordable data, automation, agentic workflows, and custom applications for growing businesses and specialized use cases.";
const ogTitle = "About Us | Amber Aardvark";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${SITE.url}/about`,
    url: `${SITE.url}/about`,
    name: "About Us | Amber Aardvark",
    description:
      "Learn how Amber Aardvark delivers affordable data, automation, agentic workflows, and custom applications for growing businesses and specialized use cases.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: "Amber Aardvark",
      description:
        "Amber Aardvark builds practical technology solutions for specialized business needs.",
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    title="Unearthing Value, Building What Fits"
    subTitle="We are problem solvers who combine data, automation, AI-assisted workflows, and custom software to make specialized business processes simpler, faster, and more affordable."
    btnExists={true}
    btnTitle="Work With Us"
    btnURL={getRelativeUrl("contact")}
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
</MainLayout>
