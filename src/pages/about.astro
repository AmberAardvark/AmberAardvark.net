---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";

// Import necessary images
import blueprints from "@images/dashboard-image.avif";
import personWorking from "@images/amber-aardvark-features.png";
import beforeAfter from "@images/amber-aardvark-map.png";
import constructionWorkers from "@images/amber-aardvark-features.png";
import aerialView from "@images/dashboard-image.avif";
import { SITE } from "@data/constants";
import { getRelativeUrl } from "@utils/utils";

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: "The Legend of the Amber Aardvark",
    subTitle:
      "Why an Aardvark? And why Amber? The Aardvark is nature's expert excavator, famous for its tenacity and ability to sniff out and dig deep to find exactly what it's looking for. Amber, on the other hand, is fossilized tree sap that captures and preserves a perfect snapshot of the world as it was at a specific moment in time. Archaeologists prize amber for the insights it reveals about ancient ecosystems.",
    single: false,
    imgOne: blueprints,
    imgOneAlt: "Data excavation concept",
    imgTwo: personWorking,
    imgTwoAlt: "Preserved insights",
  },
  {
    isRightSection: false,
    title: "Curiosity & Tenacity",
    subTitle:
      "For us, the Amber Aardvark is the ultimate symbol of our mission. We embody the aardvark's curiosity and tenacity, digging deep into your data repositories and business operations to uncover efficiencies that have been locked away. We thrive on the unexpected. In our experience, the most transformative solutions often begin with the observation, 'That's peculiar.' We chase these anomalies, knowing they are often the harbingers of the next great 'ah-ha' moment for your business. Like amber, we treat your specific data ecosystems as a precious resource that holds the key to optimizing your future.",
    img: beforeAfter,
    imgAlt: "Unlocking business workflows",
    btnExists: false,
  },
  {
    isRightSection: true,
    title: "Our Data-First Philosophy",
    subTitle:
      "Before powerful automation can take place, you must master the underlying numbers. We believe that true operational excellence shouldn't be reserved for massive enterprises with unlimited budgets. Our comprehensive, big-picture methodology combines rigorous data engineering with creative problem-solving. We look across your entire operation, knowing that a data breakthrough in one department often cascades into massive efficiencies for the whole organization. We don't just build isolated apps or automate single tasks; we build pathways to scalable growth powered by accurate insights.",
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: "Team collaboration",
    imgTwo: aerialView,
    imgTwoAlt: "Strategic overview",
  },
];

const pageTitle: string = `About Us | ${SITE.title}`;
const metaDescription =
  "Discover the story behind Amber Aardvark. Learn about our philosophy on data analytics, affordable process automation, and the unique symbolism of our mascot.";
const ogTitle = "About Us | Amber Aardvark";
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${SITE.url}/about`,
    url: `${SITE.url}/about`,
    name: "About Us | Amber Aardvark",
    description:
      "Discover the story behind Amber Aardvark. Learn about our philosophy on data analytics, affordable process automation, and the unique symbolism of our mascot.",
    isPartOf: {
      "@type": "WebSite",
      url: SITE.url,
      name: "Amber Aardvark",
      description:
        "Amber Aardvark offers top-tier data analytics, process automation, and custom application development services.",
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    title="Unearthing Value, Preserving Efficiency"
    subTitle="At Amber Aardvark, we are data engineers and workflow archaeologists, dedicated to finding hidden insights and unlocking massive growth for your team."
    btnExists={true}
    btnTitle="Work With Us"
    btnURL={getRelativeUrl("contact")}
  />

  {
    articles.map((article) => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  
  <FeaturesStats
    title="Our Impact"
    subTitle="We measure our success by the value and time we save for our clients."
    mainStatTitle="100%"
    mainStatSubTitle="Client Satisfaction"
    stats={[
      {
        stat: "50+",
        description: "Custom Workflows & Apps Delivered",
      },
      {
        stat: "10,000+",
        description: "Hours Saved Annually",
      },
      {
        stat: "24/7",
        description: "Support & Monitoring",
      },
    ]}
  />
</MainLayout>
